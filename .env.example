# Phantom Mail - Environment Configuration
# Environment variables for configuration

# Database configuration
DATABASE_URL=postgres://postgres:password@localhost:5432/tempmail

# SMTP server configuration
SMTP_ADDR=0.0.0.0:25
MAIL_DOMAIN=tempmail.example.com

# HTTP API server configuration
HTTP_ADDR=0.0.0.0:8080

# Optional: how often to delete expired mailboxes (seconds)
MAILBOX_CLEANUP_INTERVAL_SECS=60

# Optional: MQTT broker URL for email-received events
# Leave unset to disable MQTT publishing
# MQTT_BROKER_URL=mqtt://localhost:1883
