# Phantom Mail - Environment Configuration
# Environment variables for configuration

# Database configuration
# Defaults align with `docker/docker-compose.yml`.
DATABASE_URL=postgres://phantom:phantom@localhost:5432/phantommail

# SMTP server configuration
SMTP_ADDR=0.0.0.0:25
MAIL_DOMAIN=sanjula.online

# HTTP API server configuration
HTTP_ADDR=0.0.0.0:8080

# Optional: how often to delete expired mailboxes (seconds)
MAILBOX_CLEANUP_INTERVAL_SECS=60

# Optional: MQTT broker URL for email-received events
# Leave unset to disable MQTT publishing
# MQTT_BROKER_URL=mqtt://localhost:1883

# Optional: ML sidecar URL for OTP extraction, spam scoring, and categorization
# Leave unset to disable ML enrichment
# ML_SIDECAR_URL=http://localhost:9000

# Optional: SMTP TLS certificate and key paths (enables STARTTLS)
# Both must be set to enable STARTTLS
# SMTP_TLS_CERT=/etc/letsencrypt/live/sanjula.online/fullchain.pem
# SMTP_TLS_KEY=/etc/letsencrypt/live/sanjula.online/privkey.pem

# Optional: SMTP connection limits
# SMTP_MAX_CONNECTIONS=100
# SMTP_MAX_CONNECTIONS_PER_IP=5

# Path to the web UI directory (default: web)
WEB_DIR=web
