# Copy this file to .env and fill in the real values.
# .env is gitignored — never commit it.

# PostgreSQL
POSTGRES_PASSWORD=change_me_strong_password

# App — must match POSTGRES_PASSWORD above
DATABASE_URL=postgres://phantom:change_me_strong_password@postgres:5432/phantommail

# Resend SMTP relay password (API key from resend.com)
SMTP_RELAY_PASSWORD=re_your_api_key_here
